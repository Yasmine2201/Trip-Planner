### Expense tests
POST http://localhost:8000/api/trips/37/budget/expenses
# expense_group is optional
Content-Type: application/json

{
  "category": 1,
  "name": "New expense",
  "description": "NEW",
  "planned_amount": 1000,
  "actual_amount": 900,
  "is_shared": false
}
###
GET http://localhost:8000/api/trips/37/budget/expenses
###
GET http://localhost:8000/api/trips/37/budget/expenses/10
###
PUT http://localhost:8000/api/trips/37/budget/expenses/10
Content-Type: application/json

{
  "category": 1,
  "name": "New expense",
  "description": "NEW",
  "planned_amount": 1000,
  "actual_amount": 900,
  "is_shared": false,
  "expense_group": 2
}
