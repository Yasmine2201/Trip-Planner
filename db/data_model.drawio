        <mxCell id="XapSvq1-worp75ikwEZk-251" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;Question d&#39;architecture :&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Stockage des images en base de données ou dans le cloud (exemple : AWS S3) ?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;La base de données est plus simple à mettre en oeuvre, mais seulement adaptée pour des&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;petites images avec un accès peu fréquent.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Le stockage cloud permet de stocker des images plus volumineuses (&amp;gt; 1Mo), en plus grand nombre,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;avec une fréquence d&#39;accès plus élevée et de meilleures performances. Cela offre également&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;une meilleure scalabilité et allège la charge du backend (qui ne fournit que des urls)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Dans cette version, c&#39;est une mise en oeuvre naive permettant d&#39;avoir les images en base de données&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;(pour la photo de profile, l&#39;image est directement dans la table user. Pour les lieux, l&#39;image est dans une nouvelle table permettant d&#39;avoir plusieurs images par lieu.&lt;/span&gt;&lt;/div&gt;" style="text;align=left;verticalAlign=middle;resizable=1;points=[];autosize=1;strokeColor=none;fillColor=none;labelPosition=center;verticalLabelPosition=middle;overflow=visible;metaEdit=0;backgroundOutline=0;html=1;" vertex="1" parent="XapSvq1-worp75ikwEZk-1">
          <mxGeometry x="1205" y="227" width="890" height="190" as="geometry" />
        </mxCell>
