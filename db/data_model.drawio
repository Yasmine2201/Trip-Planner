        <mxCell id="qwFrMyRygRu_eB06hEgG-10" value="Question d&#39;architecture :&amp;nbsp;&lt;div&gt;stockage des images en base de données ou dans le cloud (exemple : AWS S3) ?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;La base de données est plus simple à mettre en oeuvre, mais seulement adaptée pour des&lt;/div&gt;&lt;div&gt;petites images avec un accès peu fréquent.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Le stockage cloud permet de stocker des images plus volumineuses (&amp;gt; 1Mo), en plus grand nombre,&lt;/div&gt;&lt;div&gt;avec une fréquence d&#39;accès plus élevée et de meilleures performances. Cela offre également&lt;/div&gt;&lt;div&gt;une meilleure scalabilité et allège la charge du backend (qui ne fournit que des urls)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="_Hu3HgLOWOpttOa4tnw9-1">
          <mxGeometry x="1440" y="32" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="qwFrMyRygRu_eB06hEgG-14" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#736CA8;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=none;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;" edge="1" parent="_Hu3HgLOWOpttOa4tnw9-1" source="_Hu3HgLOWOpttOa4tnw9-59" target="_Hu3HgLOWOpttOa4tnw9-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
